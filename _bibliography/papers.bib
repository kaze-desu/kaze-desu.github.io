@inproceedings{guo2026localagent,
  abbr        = {NeurIPS},
  preview     = {localagent.jpg},
  title       = {LocalAgent: Collaborative Agentic Verification for Fine-Grained Instance-Level Consistency},
  author      = {Guo, Jiachen and Zhu, Xinshan and Wang, Boyun and Liang, Yanyan and Wan, Jun and Lin, Feng and Liu, Ajian},
  booktitle   = {The Fortieth Annual Conference on Neural Information Processing Systems (NeurIPS)},
  year        = {2026},
  arxiv       = {2610.29174},
  html        = {https://openreview.net/forum?id=nJtBeEwjzg},
  code        = {https://github.com/Firefly-zoo/LocalAgent-main},
  abstract    = {Multimodal large language models (MLLMs) have made rapid progress in general visual understanding, yet they still struggle with fine-grained instance-level consistency verification, where the goal is to determine whether two images depict the exact same physical object under varying viewpoints, illumination, and backgrounds. This task requires both global semantic perception and precise examination of subtle local evidence, since semantically similar objects may differ only in small suspicious regions. We propose LocalAgent, a collaborative agentic framework that integrates the complementary strengths of a generalist MLLM and lightweight specialist verifiers. The MLLM first reasons globally to identify suspicious local regions, which are then delegated to a Local Evidence Verifier (LEV) toolkit for fine-grained appearance and geometric matching. LEV returns structured scalar evidence that the MLLM integrates for the final decision. We further introduce an auxiliary-capped reinforcement fine-tuning (RFT) strategy, in which answer correctness dominates auxiliary tool-use and format signals, enabling the policy to learn when verification is necessary. Experiments show that LocalAgent improves mean accuracy by 4.9\% over the strongest CoT-RFT baseline while invoking a verifier on only 12.13\% of samples and preserving the general multimodal capabilities of the underlying MLLM.}
}

@article{ma2026flexible,
  abbr        = {T-IFS},
  title       = {Flexible Modal Mixture-of-Experts With Inter-Modal Knowledge Distillation for Face Anti-Spoofing},
  author      = {Ma, Hui and Liu, Ajian and Li, Ning and Yang, Liying and Wang, Boyun and Zou, Hang and Zhang, Yuan and Huang, Jing and Pu, Zhiqiang and Wan, Jun and Cai, Zhanchuan and Lei, Zhen and Liang, Yanyan},
  journal     = {IEEE Transactions on Information Forensics and Security},
  volume      = {21},
  pages       = {7215--7228},
  year        = {2026},
  doi         = {10.1109/TIFS.2026.3714100},
  abstract    = {Flexible Modal Face Anti-Spoofing (FAS) aims to improve the model's adaptability to any given deployment modality. The current methods commonly use multiple independent encoders to learn modality-general features for flexible testing, which inevitably involves redundant computation. In this work, we propose a novel Flexible Modal Mixture-of-Experts (FM-MoE) for adaptively learning the representation of multi-modal data in a unified framework, which includes Modal Inter-MoE and Modal Intra-MoE. Modal Inter-MoE learns modality-general and modality-specific features, while Modal Intra-MoE replaces the traditional routing patch token strategy and extracts instance-level spoofing clues from the channel perspective. We further introduce Modal Inter Knowledge Distillation Loss (MI-KDL), which includes a Cross-Modal Loss and a Shared to Multi-Modal Loss (CML and S2MML) to align information across modalities and to transfer shared knowledge to all modalities, preventing the model from excessively optimizing certain single modalities. Extensive experiments demonstrate the flexibility and superiority of our FM-MoE framework over state-of-the-art methods.}
}
